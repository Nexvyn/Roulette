{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/v2/tooling/cli/schema.json",
  "productName": "Roulette",
  "version": "0.1.1",
  "identifier": "com.nexvyn.roulette",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Roulette",
        "width": 340,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "ROULETTE_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://github.com/Nexvyn/Roulette/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "homepage": "https://roulette.nexvyn.dev",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
